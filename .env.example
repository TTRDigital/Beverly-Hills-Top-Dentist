# Copy to .env.local for local development. The NEXT_PUBLIC_ values are read
# at build time (static export). Never commit real values.

# --- Sanity (project q5yxih7t / production are the defaults in sanity/env.ts;
# the site shows its built-in copy until the CMS has content)
NEXT_PUBLIC_SANITY_PROJECT_ID=q5yxih7t
NEXT_PUBLIC_SANITY_DATASET=production
# Only for `npm run seed` on your machine (Editor token from sanity.io/manage > API > Tokens).
SANITY_WRITE_TOKEN=

# --- Site
NEXT_PUBLIC_SITE_URL=https://beverlyhillstopdentist.com

# --- GoHighLevel
# The appointment form's webhook is NOT set here: it lives in api/lead-config.php on
# SiteGround, written by the deploy workflow from the GHL_WEBHOOK_URL GitHub secret.
# Until it is set, the form accepts submissions but does not forward them.
# Website chat widget ID (Sites > Chat Widget > Get code: data-widget-id). Empty or "off" hides the chat.
NEXT_PUBLIC_GHL_CHAT_WIDGET_ID=

# --- Analytics (optional; nothing loads when empty). The old site had no GA4/GTM tag.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
