# Beverly Hills Dental: static Next.js export on SiteGround (Apache).
# Does what a Node server would: canonical host, trailing slashes, headers, caching.

Options -Indexes
DirectoryIndex index.html index.php
# The trailing slash is added by a rewrite below (on https), not by Apache.
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address: https://beverlyhillstopdentist.com (no www), like the old site's canonical URLs.
  # (turn on "HTTPS Enforce" in SiteGround Site Tools > Security > SSL Manager too)
  RewriteCond %{HTTP_HOST} ^www\.beverlyhillstopdentist\.com$ [NC]
  RewriteRule ^(.*)$ https://beverlyhillstopdentist.com/$1 [R=301,L]

  # ---- Old WordPress URLs (generated from the old site; keep above the slash rule) ----
  # Old McLean / Virginia / duplicate pages: 301 to their Beverly Hills page.
  RewriteRule ^services/restorative-dentistry/tmj-tmd-treatments/?$ https://%{HTTP_HOST}/services/restorative-dentistry/ [R=301,L,NC]
  RewriteRule ^locations/mclean/dental-implant-dentistry/?$ https://%{HTTP_HOST}/services/dental-implants-dentistry/ [R=301,L,NC]
  RewriteRule ^locations/mclean/porcelain-dental-veneers/?$ https://%{HTTP_HOST}/services/cosmetic-dentistry/porcelain-veneers/ [R=301,L,NC]
  RewriteRule ^locations/mclean/wisdom-teeth-extractions/?$ https://%{HTTP_HOST}/services/restorative-dentistry/wisdom-teeth-extractions/ [R=301,L,NC]
  RewriteRule ^preventive-dentistry-in-northern-virginia/?$ https://%{HTTP_HOST}/services/preventive-dentistry/ [R=301,L,NC]
  RewriteRule ^locations/mclean/porcelain-inlays-onlays/?$ https://%{HTTP_HOST}/services/restorative-dentistry/porcelain-inlays-onlays/ [R=301,L,NC]
