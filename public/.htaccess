  RewriteRule ^locations/mclean/gum-disease-treatment/?$ https://%{HTTP_HOST}/services/periodontic-dentistry/gum-disease-treatment/ [R=301,L,NC]
  RewriteRule ^locations/mclean/periodontal-dentistry/?$ https://%{HTTP_HOST}/services/periodontic-dentistry/ [R=301,L,NC]
  RewriteRule ^locations/mclean/restorative-dentistry/?$ https://%{HTTP_HOST}/services/restorative-dentistry/ [R=301,L,NC]
  RewriteRule ^locations/mclean/single-tooth-implants/?$ https://%{HTTP_HOST}/services/dental-implants-dentistry/single-tooth-implants/ [R=301,L,NC]
  RewriteRule ^locations/mclean/sleep-apnea-treatment/?$ https://%{HTTP_HOST}/services/preventive-dentistry/sleep-apnea-treatment/ [R=301,L,NC]
  RewriteRule ^services/cosmetic-dentistry/invisalign/?$ https://%{HTTP_HOST}/services/cosmetic-dentistry/clear-aligners/ [R=301,L,NC]
  RewriteRule ^locations/mclean/laser-gum-treatments/?$ https://%{HTTP_HOST}/services/periodontic-dentistry/laser-gum-treatments/ [R=301,L,NC]
