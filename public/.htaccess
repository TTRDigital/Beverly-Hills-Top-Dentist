  # WordPress sitemaps and the author page.
  RewriteRule ^(?:sitemap_index|wp-sitemap|[a-z_-]+-sitemap\d*|wp-sitemap-[a-z0-9_-]+)\.xml$ https://%{HTTP_HOST}/sitemap.xml [R=301,L,NC]
  RewriteRule ^author/[^/]+/?$ https://%{HTTP_HOST}/about-us/ [R=301,L,NC]
  # WordPress-only paths that no longer exist: 410 Gone, so search engines drop them.
  RewriteRule ^(?:wp-admin|wp-includes|wp-json|wp-content/(?:themes|plugins|cache|languages))(?:/|$) - [G,L,NC]
  RewriteRule ^(?:wp-login|xmlrpc|wp-cron|wp-signup|wp-trackback|wp-comments-post)\.php$ - [G,L,NC]
  RewriteRule ^(?:.+/)?(?:feed|trackback|embed)/?$ - [G,L,NC]
  RewriteRule ^(?:category|tag)/ - [G,L,NC]
  RewriteCond %{QUERY_STRING} (?:^|&)(?:rest_route|feed|attachment_id)= [NC]
  RewriteRule ^(?:index\.php)?$ - [G,L]
  # ---- end of old WordPress URLs ----

  # Build-time placeholder for the empty blog route (static export needs one path).
  RewriteRule ^blog/_none/?$ - [R=404,L]

  # Pages live at /page/ (page/index.html): add the missing slash, on https
  # (absolute, so visitors behind SiteGround's proxy are not bounced through http).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]

  # The Sanity Studio is one page; its inner URLs (/cms/structure/...) load it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^cms/. /cms/index.html [L]
</IfModule>

# The form's settings file and the upload tool's file list are never served.
<FilesMatch "^(lead-config\.php|\.ftp-deploy-sync-state\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # CSP for the site. Third parties allowed: Google Analytics / Tag Manager (when
  # their IDs are set), Sanity images, the GoHighLevel (LeadConnector) chat
  # widget and its anti-spam check. If you add tags in GTM that load other
  # scripts, add their domains here.
  # The studio at /cms talks to many Sanity hosts and is protected by Sanity login instead.
  <If "%{REQUEST_URI} !~ m#^/cms(/|$)#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.googletagmanager.com https://*.leadconnectorhq.com https://*.msgsndr.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://*.leadconnectorhq.com https://*.msgsndr.com https://fonts.googleapis.com https://fonts.bunny.net; img-src 'self' data: blob: https:; font-src 'self' data: https://*.leadconnectorhq.com https://*.msgsndr.com https://fonts.gstatic.com https://fonts.bunny.net; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.leadconnectorhq.com https://*.msgsndr.com wss://*.leadconnectorhq.com https://*.googleapis.com https://challenges.cloudflare.com; frame-src 'self' https://www.googletagmanager.com https://www.google.com https://*.leadconnectorhq.com https://*.msgsndr.com https://challenges.cloudflare.com; media-src 'self' blob: https://cdn.sanity.io; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  </If>

  # Caching: hashed build files forever, photos and video for a month, pages always fresh.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType video/webm .webm
  AddType video/mp4 .mp4
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml text/plain
</IfModule>
